{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editeur Markdown",
  "version": "1.1.0",
  "identifier": "local.mdtauri.editor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Éditeur Markdown",
        "width": 1100,
        "height": 680,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http://mdimg.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "David Fernando",
    "shortDescription": "Éditeur Markdown léger",
    "longDescription": "Éditeur Markdown en Rust et Tauri : aperçu en direct, onglets, vue fractionnée, images locales, code coloré, formules, schémas Mermaid, export HTML et PDF.",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Markdown",
        "description": "Document Markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
