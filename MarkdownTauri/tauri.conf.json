{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editeur Markdown",
  "version": "0.1.0",
  "identifier": "local.mdtauri.editor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Éditeur Markdown",
        "width": 1100,
        "height": 680,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}